{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "a846332f1f922f09333bfca81de45b3b47bf2f5b",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": "@",
  "plugins": ["node-workspace"],
  "packages": {
    "packages/composables": { "component": "@aplicacoesboilerplate/composables" },
    "packages/utils": { "component": "@aplicacoesboilerplate/utils" },
    "packages/ui/core": { "component": "@aplicacoesboilerplate/ui-core" },
    "packages/ui/prime-vue": { "component": "@aplicacoesboilerplate/ui-prime-vue" },
    "packages/ui/vuetify": { "component": "@aplicacoesboilerplate/ui-vuetify" },
    "apps/docs": {
      "component": "@aplicacoesboilerplate/docs",
      "skip-github-release": true,
      "skip-changelog": true,
      "exclude-paths": ["apps/docs"]
    }
  }
}
