{
  "name": "@aplicacoesboilerplate/packages-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "verify": "turbo run lint type-check test build",
    "changeset": "changeset",
    "dev:docs": "npm run dev --workspace @aplicacoesboilerplate/docs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "eslint --config config/eslint.config.js . --fix",
    "pack:check": "npm run pack:check --workspaces --if-present",
    "prepare": "husky",
    "release:publish": "changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.4",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.15.18",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.102.0",
    "turbo": "^2.10.11",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "prettier": "./config/prettier.config.cjs",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --config config/eslint.config.js --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}
